          }

        >

          <Text

            style={

              styles.backText

            }

          >

            ← Cambiar perfil

          </Text>

        </Pressable>

      </ScrollView>

    );

  }



  /* =======================================================

     ADULTO

  ======================================================= */



  if (

    perfil ===

