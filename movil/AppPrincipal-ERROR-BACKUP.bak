                volverInicio

              }

            >

              <Text

                style={

                  styles.topBackText

                }

              >

                ←

              </Text>

            </Pressable>



            <Text

              style={

                styles.topBarTitle

              }

            >

              Escuchar

            </Text>



            <View

              style={

                styles.topBarSpacer

              }

            />

