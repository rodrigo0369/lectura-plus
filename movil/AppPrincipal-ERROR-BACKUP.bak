              styles.ninoContainer

            }

          >

            <Text

              style={

                styles.ninoLogo

              }

            >

              Lectura+ ⭐

            </Text>



            <Text

              style={

                styles.ninoTitle

              }

            >

              📊 Mi progreso

            </Text>



            <View

