            )

          }

        >

          <Text

            style={

              styles.buttonText

            }

          >

            🔊 Escuchar un texto

          </Text>

        </Pressable>



        <Pressable

          style={

            styles.button

          }

        >

          <Text

            style={

              styles.buttonText

            }

          >

            📊 Mi progreso

          </Text>

        </Pressable>



        <Pressable

          style={

            styles.backButton

          }

